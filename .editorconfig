# SPDX-License-Identifier: AGPL-3.0-only
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{c,h}]
indent_style = tab

[*.{md,yml,yaml,toml,sh,mk,conf}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
