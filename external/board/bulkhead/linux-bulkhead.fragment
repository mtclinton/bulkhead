# SPDX-License-Identifier: AGPL-3.0-only
# bulkhead security kernel config fragment.
# Merged over board/qemu/x86_64/linux.config via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
# Provides the cgroup v2 + namespaces + seccomp + Landlock + BPF-LSM + BTF
# substrate, the cgroup-attached BPF the systemd egress firewall needs, netfilter
# for the nftables default-deny egress, TUN for Tailscale, and TPM support.

# --- expose the running config so verify-floor can read /proc/config.gz ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- BPF core + CO-RE (BTF) + ring buffer (RINGBUF is part of BPF_SYSCALL) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
# Tracing prerequisites: BPF_EVENTS (required by BPF_LSM) depends on
# (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS, which in turn need FTRACE +
# KPROBES. Without these, BPF_EVENTS — and therefore BPF_LSM — silently drop
# during 'make olddefconfig'.
CONFIG_FTRACE=y
# FUNCTION_TRACER pulls in DYNAMIC_FTRACE + DYNAMIC_FTRACE_WITH_DIRECT_CALLS,
# which BPF-LSM / fentry programs require to install their trampoline on the
# bpf_lsm_* hook functions. Without it, link.AttachLSM fails with EBUSY.
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# BTF (CO-RE): the "Debug information" choice is gated on DEBUG_KERNEL; without
# it DEBUG_INFO stays off and DEBUG_INFO_BTF silently drops.
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- LSM framework: BPF-LSM + Landlock + Yama + lockdown; seccomp (orthogonal) ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
# Socket-family LSM hooks (security_socket_connect, ...) — required for the
# collector's lsm/socket_connect BPF program to find bpf_lsm_socket_connect.
CONFIG_SECURITY_NETWORK=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# bpf MUST be listed to be active; ordered AFTER the enforcing LSMs (landlock).
CONFIG_LSM="landlock,lockdown,yama,bpf"

# --- ADR-0033: compile out io_uring (kept in sync with the Yocto bulkhead-security.cfg) ---
# io_uring is a syscall-invisible I/O channel; the jails ban its syscalls by seccomp and this is the
# kernel-level defense-in-depth floor (ENOSYS even if a jail filter is wrong; the ADR-0042 Firecracker
# guest reuses this kernel so it gets no in-VM io_uring). Nothing in the appliance consumes it.
# IO_URING is EXPERT-gated (`bool "..." if EXPERT default y`), so EXPERT=y is required to make the
# disable effective; EXPERT only unhides prompts (values stay at their unconditional defaults).
CONFIG_EXPERT=y
# CONFIG_IO_URING is not set
# Neutralize EXPERT's side effects (net change = io_uring only): it unhides prompts whose EXPERT-default
# differs — the media subdriver filter goes off (dragging in DVB/tuner/radio), and a batch of HID/input/
# rfkill drivers + DEBUG_MEMORY_INIT flip off. Pin them back (MEDIA_SUPPORT_FILTER reverts the media block).
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_HIDE_ANCILLARY_SUBDRV=y
CONFIG_DEBUG_MEMORY_INIT=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_RFKILL_INPUT=y
CONFIG_HID_A4TECH=y
CONFIG_HID_APPLE=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_ITE=y
CONFIG_HID_KENSINGTON=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_REDRAGON=y
# CONFIG_TTY_PRINTK is not set

# --- cgroup v2 + controllers + cgroup-attached BPF ---
# CONFIG_CGROUP_BPF is REQUIRED or systemd's IPAddressDeny= egress firewall
# silently fails open (logs a warning, runs with no firewall).
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_SOCK_CGROUP_DATA=y

# --- namespaces (agent jails) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- TPM (vTPM via swtpm in qemu; real TPM on bare metal) ---
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y

# --- netfilter + nf_tables + conntrack (default-deny egress, M4) ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NF_LOG_SYSLOG=y

# --- TUN for Tailscale kernel mode (M4) ---
CONFIG_TUN=y
