# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=bulkhead Tailscale node join
After=tailscaled.service mnt-tsauth.mount bulkhead-firewall.service bulkhead-attest-gate.service
Wants=tailscaled.service
Requires=mnt-tsauth.mount
# ADR-0021 load-bearing posture gate: only join the tailnet when the box is in the expected ENFORCING
# posture (E0+E2 armed + tcb clean). Requires= => a not-armed gate (its oneshot exits non-zero) refuses
# this join with a dependency-failed result. Break-glass: re-arm enforce, or mask the gate (see
# deploy/tailscale-join.md). The ExecStartPre below re-checks at the moment of join (closes the manual-
# `systemctl start` seam where systemd may re-pull a failed Requires dependency).
Requires=bulkhead-attest-gate.service
# Only join when the provisioning key is present; otherwise tailscaled stays
# idle and this is skipped (graceful on key-less boots).
ConditionPathExists=/mnt/tsauth/authkey

[Service]
Type=oneshot
RemainAfterExit=yes
# Fail-closed posture re-check at the instant of join (belt-and-suspenders to the Requires= above);
# controlRPCGate inside it tolerates the boot race but returns a not-armed ERR immediately.
ExecStartPre=/usr/bin/bulkhead-collector attest gate
# The key is read from the provisioning volume at runtime (file: keeps it out of
# the process arguments). Production seals it with systemd-creds — see
# deploy/tailscale-join.md.
ExecStart=/usr/bin/tailscale up --auth-key=file:/mnt/tsauth/authkey \
    --hostname=bulkhead-appliance --accept-routes=false --ssh=false

[Install]
WantedBy=multi-user.target
