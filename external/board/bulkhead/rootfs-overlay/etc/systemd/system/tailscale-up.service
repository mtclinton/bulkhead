# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=bulkhead Tailscale node join
After=tailscaled.service mnt-tsauth.mount bulkhead-firewall.service bulkhead-attest-gate.service bulkhead-attest-selfcheck-gate.service
Wants=tailscaled.service
Requires=mnt-tsauth.mount
# ADR-0021 load-bearing posture gate: only join the tailnet when the box is in the expected ENFORCING
# posture (E0+E2 armed + tcb clean). Requires= => a not-armed gate (its oneshot exits non-zero) refuses
# this join with a dependency-failed result. Break-glass: re-arm enforce, or mask the gate (see
# deploy/tailscale-join.md). The ExecStartPre below re-checks at the moment of join (closes the manual-
# `systemctl start` seam where systemd may re-pull a failed Requires dependency). This is the
# UNCONDITIONAL gate (conditioned on the collector BINARY, not the TPM) — it gates a TPM-less box too.
Requires=bulkhead-attest-gate.service
# ADR-0023 load-bearing CRYPTOGRAPHIC gate, LAYERED ON TOP (augment, never replace): also require a
# fresh-nonce TPM-signed self-verify against the expected default-armed D. ConditionPathExists=
# /dev/tpmrm0 in that unit means a TPM-LESS box SKIPS it (systemd treats a skipped Requires= dependency
# as satisfied), so a no-TPM enforcing box is NOT bricked and is STILL gated by the map-read gate above.
Requires=bulkhead-attest-selfcheck-gate.service
# Only join when the provisioning key is present; otherwise tailscaled stays
# idle and this is skipped (graceful on key-less boots).
ConditionPathExists=/mnt/tsauth/authkey

[Service]
Type=oneshot
RemainAfterExit=yes
# Fail-closed posture re-check at the instant of join (belt-and-suspenders to the Requires= above);
# controlRPCGate inside it tolerates the boot race but returns a not-armed ERR immediately.
ExecStartPre=/usr/bin/bulkhead-collector attest gate
# ADR-0023 crypto self-check re-check at the instant of join. `-` prefix: on a TPM-less box the
# selfcheck cannot run, but the gate UNIT is Condition-skipped there (so the Requires= is satisfied) —
# the `-` keeps this manual-`systemctl start` belt-and-suspenders from bricking a no-TPM box, while the
# selfcheck-gate Requires= remains the hard fail-closed edge on a TPM box (selfcheck FAIL => unit fails).
ExecStartPre=-/usr/bin/bulkhead-collector attest selfcheck
# The key is read from the provisioning volume at runtime (file: keeps it out of
# the process arguments). Production seals it with systemd-creds — see
# deploy/tailscale-join.md.
ExecStart=/usr/bin/tailscale up --auth-key=file:/mnt/tsauth/authkey \
    --hostname=bulkhead-appliance --accept-routes=false --ssh=false

[Install]
WantedBy=multi-user.target
