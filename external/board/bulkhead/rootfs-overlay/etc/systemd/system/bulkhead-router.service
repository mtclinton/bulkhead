# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=bulkhead request router (local llama.cpp | Anthropic API)
Documentation=https://github.com/mtclinton/bulkhead
After=llama-server.service bulkhead-selftest.service
Requires=bulkhead-selftest.service
# Note: deliberately NOT ordered after network-online.target — that target is
# never reached unless systemd-networkd-wait-online is enabled, and the router
# does not need it (it binds a local port and dials upstreams lazily).

[Service]
Type=exec
DynamicUser=yes
# ADR-0034: also expose the router on a unix socket so a confined agent (PrivateNetwork,
# no route) can reach the model leg. RuntimeDirectory gives this DynamicUser its own
# /run/bulkhead-router; the router creates router.sock (0666) there for the jail to dial.
RuntimeDirectory=bulkhead-router
RuntimeDirectoryMode=0755
Environment=BULKHEAD_ROUTER_UDS=/run/bulkhead-router/router.sock
ExecStart=/usr/bin/bulkhead-router
Restart=on-failure
RestartSec=2
# Front door binds loopback in the prototype; M4 rebinds it to the tailnet.
# The local inference backend is reached on loopback.
Environment=BULKHEAD_LISTEN=127.0.0.1:8080
Environment=BULKHEAD_LLAMA_URL=http://127.0.0.1:8081
# Denial-of-wallet bound (security-review R7). 0 = unlimited (the default — the per-request tier gate
# is the only paid-path control). Set to N to cap PAID (api-route) calls at N/minute: a compromised
# agent looping threshold-length requests is refused with 429 once the budget is spent, before any
# upstream paid call. The local/free route is never throttled. The operator sets N for their budget.
Environment=BULKHEAD_ROUTER_PAID_RATE_PER_MIN=0
# The Anthropic key is delivered at runtime via a systemd credential drop-in
# (see deploy/anthropic-credential.md) so 'api' routes work; absent it, 'api'
# routes return 503 and 'local' routes still work. The key is never in the image.

# --- hardening (the router needs egress to api.anthropic.com; the M4
#     nftables/dnsmasq floor adds the default-deny egress allowlist on top) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @obsolete @cpu-emulation @mount @reboot @swap @raw-io @module
SystemCallErrorNumber=EPERM
# AF_UNIX is REQUIRED, not optional: the router serves BULKHEAD_ROUTER_UDS (the confined agent's
# model leg, ADR-0034) via net.Listen("unix", …). Without AF_UNIX here, socket(AF_UNIX) returns
# EAFNOSUPPORT, the UDS listen fails fatally, and the router CRASH-LOOPS (Restart=on-failure) —
# leaving every confined jail with no model path. The egress proxy already lists AF_UNIX for the
# same reason; this line was the one that forgot it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
