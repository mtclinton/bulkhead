# ADR-0042 slice 6: the DEPLOYABLE Firecracker hostile-tier agent (instance %i), the sibling of
# bulkhead-agent-runsc@. `systemctl start bulkhead-agent-firecracker@<inst>` boots a microVM running a
# bulkhead agent whose ONLY way out is the mediated vsock leg -> the per-instance mux -> the host egress
# proxy/router. The microVM (a separate guest kernel) is the isolation boundary; the host unit stays minimal.
#
# Build-verified (the qemu suite has no nested KVM to live-boot a microVM); the mechanism is live-proven
# host-side (slices 1-4). Runtime needs /dev/kvm (bare metal / a nested-KVM host). The jailer confinement of
# the VMM is the documented hardening follow-up (see the launcher).
[Unit]
Description=bulkhead agent in a Firecracker microVM (instance %i)
Documentation=https://github.com/mtclinton/bulkhead
# The per-instance mux must be up (listening) before firecracker (the vsock client) dials; the fail-closed
# selftest gate must pass before any agent tier starts.
Requires=bulkhead-fc-vsockmux@%i.service bulkhead-egress-proxy.service bulkhead-selftest.service
After=bulkhead-fc-vsockmux@%i.service bulkhead-egress-proxy.service bulkhead-selftest.service

[Service]
Type=exec
# Runs as root: firecracker needs /dev/kvm (and the hardening-follow-up jailer needs root to confine the VMM).
ExecStart=/usr/bin/bulkhead-agent-firecracker-launch %i
ExecStopPost=-/bin/sh -c 'rm -rf /run/bulkhead-fc-vm/%i'
TimeoutStopSec=20
NoNewPrivileges=yes
# Defense-in-depth for a root unit on a networked host (the VMM/jailer is the real boundary, but the host
# launcher process is still root). Only directives that do NOT interfere with /dev/kvm, the /run rootfs
# build, or the jailer follow-up are applied. DELIBERATELY OMITTED until bare-metal validation / the jailer:
# PrivateDevices (needs /dev/kvm), ProtectControlGroups + RestrictNamespaces (the jailer creates the agent's
# cgroup + empty netns), MemoryDenyWriteExecute + an empty CapabilityBoundingSet (un-boot-testable against
# firecracker in this no-nested-KVM harness — defer rather than risk bricking the tier).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
