# SPDX-License-Identifier: AGPL-3.0-only
# Inter-agent egress delegation broker (ADR-0006). ADR-0018: BOOT-STARTED (not lazily
# socket-activated) and handed bulkhead-broker.socket's listening fd via LISTEN_FDS, so the broker
# is RUNNING and collector-TCB-registered before E0 arms at boot (its cgroup must EXIST for the
# enforce unit's `ctl wait-broker-tcb` gate to resolve it). Computes child = parent ∩ requested
# (narrow-never-widen) and launches the child as a normal bulkhead-agent@ instance, so ADR-0005's
# verified +ExecStartPre ordering closes the connect-vs-manifest race. TCB but caged.
[Unit]
Description=bulkhead inter-agent delegation broker
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-collector.service
Requires=bulkhead-collector.service
# ADR-0018: the .socket stays the SOLE owner of /run/bulkhead/broker.sock (and the sole creator of
# /run/bulkhead via RuntimeDirectory). Wants=/After= it so PID-1 has the socket listening and hands
# this boot-started service the activation fd (LISTEN_FDS) — brokerListener takes the FileListener
# branch and NEVER rebinds the path (the fallback is fail-closed unless BULKHEAD_BROKER_PATH_BIND=1).
Wants=bulkhead-broker.socket
After=bulkhead-broker.socket
# ADR-0016: ordered BEFORE the E0-arming unit so PID-1 has materialized the broker cgroup and the
# broker has self-requested TCB registration (via the collector control socket) before E0 arms.
Before=bulkhead-enforce.service
# Composed-review fix (broker de-TCB on collector restart): the collector os.RemoveAll(pinDir) +
# re-pins a fresh tcb_cgroups (root+collector, plus a pin-time broker pre-register) on every run.
# PartOf= makes a collector restart also restart the broker, so it re-runs its (ADR-0016) control-
# socket TCB registration against the new map (E0 is reset to observe by the same restart). The
# collector GC reconcileTCB additionally ENSURES the live broker is present and prunes any STALE
# broker cgid left by an independent broker re-activation.
PartOf=bulkhead-collector.service

[Service]
Type=exec
ExecStart=/usr/bin/bulkhead-collector broker
# TCB side: read+write the pinned egress_policy/grant_once maps (CAP_BPF) for the gated EXPAND/
# NARROW/GRANT actions, and launch child jails by asking PID-1. ADR-0016: the broker no longer
# self-bpf()s into tcb_cgroups (that EPERMs under E0 from its non-TCB cgroup); it asks the
# collector, over the control socket, to register it — so the broker's CAP_BPF map ops survive E0
# because its cgroup is genuinely in tcb_cgroups (collector-granted), not self-granted.
User=root
AmbientCapabilities=CAP_BPF
CapabilityBoundingSet=CAP_BPF
NoNewPrivileges=yes
ProtectSystem=strict
# Writable holes: the child's transient egress drop-in, the operator control socket
# (/run/bulkhead/approve.sock, created by the broker at 0600), the delegated-child task
# credential sources (/run/bulkhead/tasks/<inst>.task, 0640, ADR-0015 — PID-1 LoadCredentials
# them into each child), and its own signed decision log under the state dir.
ReadWritePaths=/run/systemd/system /run/bulkhead
StateDirectory=bulkhead
Environment=BULKHEAD_AUDIT_DIR=/var/lib/bulkhead/audit-broker
# Cap delegation recursion height (ADR-0015): worker -> d1 -> d2 -> d3, then ERR too-deep. The
# depth is derived from the kernel-attested parent instance name, never anything an agent sends.
Environment=BULKHEAD_MAX_DELEGATE_DEPTH=3
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
# Broker speaks only AF_UNIX (its activation socket, PID-1's private bus) + reads /proc;
# it NEVER makes outbound network connections.
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=no

# ADR-0018: boot-started so the broker is up + TCB before E0 arms (hardened-by-default). PID-1
# still passes the bulkhead-broker.socket fd (Wants=/After= above), so this is not a second owner.
[Install]
WantedBy=multi-user.target
