# Inter-agent egress delegation broker (ADR-0006). Socket-activated by
# bulkhead-broker.socket. Computes child = parent ∩ requested (narrow-never-widen) and
# launches the child as a normal bulkhead-agent@ instance, so ADR-0005's verified
# +ExecStartPre ordering closes the connect-vs-manifest race. TCB but caged.
[Unit]
Description=bulkhead inter-agent delegation broker
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-collector.service
Requires=bulkhead-collector.service
# Composed-review fix (broker de-TCB on collector restart): the broker self-registers its
# cgroup into tcb_cgroups ONCE at startup, but the collector os.RemoveAll(pinDir) + re-pins a
# fresh tcb_cgroups (root+collector only) on every run. PartOf= makes a collector restart
# also restart the broker, so it re-runs brokerSelfRegisterTCB against the new map (E0 is
# reset to observe by the same restart, so the self-register bpf() succeeds). The collector
# GC additionally prunes any STALE broker cgid left by an independent broker re-activation.
PartOf=bulkhead-collector.service

[Service]
Type=exec
ExecStart=/usr/bin/bulkhead-collector broker
# TCB side: read the pinned egress_policy/tcb_cgroups maps (CAP_BPF) and self-register
# this unit's cgroup into tcb_cgroups (so its bpf() survives E0 and its IPC is E2-exempt);
# launch child jails by asking PID-1 (root over the private bus). NB: self-registration
# needs E0 OFF at first run — the MVP default (see ADR-0006).
User=root
AmbientCapabilities=CAP_BPF
CapabilityBoundingSet=CAP_BPF
NoNewPrivileges=yes
ProtectSystem=strict
# Writable holes: the child's transient egress drop-in, the operator control socket
# (/run/bulkhead/approve.sock, created by the broker at 0600), and its own signed
# decision log under the state dir.
ReadWritePaths=/run/systemd/system /run/bulkhead
StateDirectory=bulkhead
Environment=BULKHEAD_AUDIT_DIR=/var/lib/bulkhead/audit-broker
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
# Broker speaks only AF_UNIX (its activation socket, PID-1's private bus) + reads /proc;
# it NEVER makes outbound network connections.
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=no
# No [Install]: started on demand by bulkhead-broker.socket.
