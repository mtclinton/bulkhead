# SPDX-License-Identifier: AGPL-3.0-only
# bulkhead-egress-proxy — host-mediated egress boundary (ADR-0034, increment 1).
# A confined agent (bulkhead-agent-confined@) runs in a no-route netns and reaches the
# outside ONLY through this proxy's unix socket: the proxy resolves on the host, checks the
# advisory allowlist against a single canonical parse, denies internal IP classes (SSRF/
# metadata), and splices. TLS rides through opaque (content inspection is increment 2).
[Unit]
Description=bulkhead host-mediated egress proxy (ADR-0034)
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-firewall.service bulkhead-selftest.service
Wants=bulkhead-firewall.service
# Fail-closed gate (mirrors the trusted router leg). The UNTRUSTED-web egress chokepoint must not
# start if the boot self-test fails — and on Yocto bulkhead-selftest Requires= the audit-chain
# verifier (10-verify-chain.conf), so a forged/gapped /data chain refuses this proxy AND transitively
# every confined/runsc agent that Requires= it. Before this, verify-audit only Before=-ordered the
# proxy, which does not propagate failure — so a tampered chain refused the TCB but not web egress.
Requires=bulkhead-selftest.service

[Service]
Type=exec
DynamicUser=yes
RuntimeDirectory=bulkhead-egress
RuntimeDirectoryMode=0755
Environment=BULKHEAD_EGRESS_SOCK=/run/bulkhead-egress/egress.sock
Environment=BULKHEAD_EGRESS_ALLOWLIST=/etc/bulkhead/egress-allow.conf
# Default-deny internal destinations; an operator opts specific CIDRs in here.
Environment=BULKHEAD_EGRESS_ALLOW_INTERNAL_CIDRS=
# High-assurance egress posture (ADR-0034 inc2). Empty = the inc1-compatible `passthrough` default
# (a host is body-inspected only when its allowlist entry says `inspect`). Set to `inspect` to flip
# the default for UNMARKED entries: every allowed host is then TLS-terminated + content-inspected, or
# DENIED if it cannot be terminated (the inspect fail-closed rule) — an explicit per-entry mode wins.
Environment=BULKHEAD_EGRESS_DEFAULT_MODE=
ExecStart=/usr/bin/bulkhead-egress-proxy
Restart=on-failure
RestartSec=2

# --- signed egress-decision chain (ADR-0017/0034). StateDirectory gives this DynamicUser a
#     persistent, correctly-owned dir under ProtectSystem=strict; it joins the fixed bulkhead-audit
#     group so a Yocto /data drop-in can group-share the chain across boots (same pattern as the
#     router). On Yocto the data drop-in redirects BULKHEAD_AUDIT_DIR to /data + delivers the
#     TPM-sealed seed; in dev the chain lives here and self-verifies via the exported audit-pub.txt. ---
StateDirectory=bulkhead/audit-egress
Environment=BULKHEAD_AUDIT_DIR=/var/lib/bulkhead/audit-egress
SupplementaryGroups=bulkhead-audit

# --- hardening floor (the router/llama profile; the proxy needs INET egress upstream) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @obsolete @cpu-emulation @mount @reboot @swap @raw-io @module
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
