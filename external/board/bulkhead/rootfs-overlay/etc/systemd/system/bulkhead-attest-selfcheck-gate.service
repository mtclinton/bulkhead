# SPDX-License-Identifier: AGPL-3.0-only
# ADR-0023: CRYPTOGRAPHIC self-check GATE — the on-box upgrade of the load-bearing gate from a live
# map-READ (ADR-0021) to a TPM-SIGNED self-verify. The box produces a FRESH-NONCE quote of the
# BOOT-extended PCR 14 and runs the five `attest verify` checks against the expected DEFAULT-ARMED D,
# all in the COLLECTOR (TCB). The boot PCR is IMMUTABLE, so a pass proves the box BOOTED in the
# expected default-armed posture — catching a NEVER-ARMED boot AND a runtime MAP-FLIP (the map read
# passes but the immutable boot PCR does not), NEITHER of which the ADR-0021 map read catches.
# STRENGTH DEPENDS ON THE PIN: with a pre-provisioned EK-rooted pin (/data) the quote's AK is matched
# to a KNOWN TPM key, authenticating the quote as genuine-TPM and rejecting a SOFTWARE-FORGED quote; in
# the STRUCTURAL FALLBACK (no pin — the shipped default under qemu) the verifying AK is the quote's
# OWN, so it does NOT authenticate the TPM and does NOT catch a TAMPERED collector (which forges the
# whole envelope in software) — assuming an honest collector it adds freshness + the immutable boot
# PCR over the map read. HONEST LIMITS: a SAME-BOX self-check, strictly WEAKER than the off-box
# relying-party verify (scripts/qemu-attest-check.py). It does NOT catch a runtime in-TCB compromise
# AFTER the boot extend (PCR is a boot snapshot), nor a BINARY SWAP (the expected D hashes the box's
# OWN /proc/self/exe, so a swapped collector self-derives a matching D).
#
# AUGMENT, NEVER REPLACE: this is a SECOND gate LAYERED on top of the UNCONDITIONAL ADR-0021 map-read
# gate (bulkhead-attest-gate.service), NOT a replacement. A crypto gate needs a TPM, so it
# ConditionPathExists=/dev/tpmrm0 — on a legitimately TPM-LESS but enforcing box this unit is cleanly
# Condition-SKIPPED (systemd treats a skipped Requires= dependency as satisfied), so the box is NOT
# bricked AND is STILL gated by the ADR-0021 map read. Replacing the map read with this crypto-only gate
# would FAIL-OPEN the no-TPM box — the regression this layering avoids.
#
# `attest selfcheck` is a thin CONTROL-SOCKET client: the TPM extend/quote AND the bpf() map reads (for
# the in-process expected-D / quote) would fail from this non-TCB unit's cgroup under armed-E0, so the
# COLLECTOR (TCB) does the quote + verify in-process and replies OK / ERR. controlRPCGate absorbs the
# socket-bind boot race (transport-only retry) while returning a crypto-FAIL server ERR immediately.
[Unit]
Description=bulkhead cryptographic self-attest GATE (TPM-signed quote self-verify, load-bearing)
Documentation=https://github.com/mtclinton/bulkhead
# CRYPTO GUARD: a crypto gate needs the TPM. On a TPM-less box this SKIPS (the ADR-0021 map-read gate
# still gates — AUGMENT not REPLACE; conditioning the MAP-READ gate on /dev/tpmrm0 would be the bug).
ConditionPathExists=/dev/tpmrm0
# Also require the collector binary (any bulkhead image ships it; absent in a stripped/recovery image).
ConditionPathExists=/usr/bin/bulkhead-collector
# Order AFTER the boot extend (bulkhead-attest.service) so PCR 14 already holds the extended D, and
# AFTER both enforce arms so the box is in its default-armed steady state before we quote it.
After=bulkhead-collector.service bulkhead-enforce.service bulkhead-enforce-egress.service bulkhead-attest.service
Requires=bulkhead-collector.service
# Re-evaluate against the fresh box state after a collector restart (RemoveAll-reset + re-arm + re-
# extend). PartOf makes a collector restart restart this oneshot, so a stale "active" gate can't outlive
# a re-arm. (The boot PCR is sticky across a collector restart without a reboot — see ADR-0023 honest
# limits — so this re-run is a freshness/liveness re-quote, not a fresh boot measurement.)
PartOf=bulkhead-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Exit 0 iff the collector (TCB) produced a fresh-nonce quote that VERIFIES against the expected
# default-armed D (genuine TPM + fresh nonce + exactly-PCR-14 + PCR == H(0^32||D)).
ExecStart=/usr/bin/bulkhead-collector attest selfcheck

[Install]
WantedBy=multi-user.target
