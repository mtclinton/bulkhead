# SPDX-License-Identifier: AGPL-3.0-only
# BPF-LSM enforce arming for the socket_connect hook (E2 per-agent egress). Sibling of
# bulkhead-enforce.service (the bpf hook). ADR-0018: AUTO-ENABLED — the shipped image enforces
# per-agent egress manifests BY DEFAULT (E0 alone seals the bpf substrate but leaves egress in
# observe, a half-guarantee). No broker-TCB dependency (per-agent egress_policy is keyed by agent
# cgid; a non-agent cgroup with no entry is ALLOW), so it arms gate-free, in parallel with E0.
# Soft-disarm with `systemctl stop bulkhead-enforce-egress` (routed through the collector).
# Disarm (soft, no reboot): `systemctl stop bulkhead-enforce-egress` (clears the toggle)
# or `bulkhead-collector enforce off socket_connect`. Fail-open: if the collector isn't
# up, this unit just fails and egress stays in observe mode.
[Unit]
Description=bulkhead BPF-LSM enforce arming (opt-in: socket_connect / E2 per-agent egress)
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-collector.service
Requires=bulkhead-collector.service
# ADR-0016 review fix: re-arm against the fresh map after a collector restart (else E2 silently
# drops to observe while this unit still reports armed). The `enforce` writes route through the
# collector control socket, so disarm works even when E0 (bpf hook) is also armed.
PartOf=bulkhead-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bulkhead-collector enforce on socket_connect
ExecStop=/usr/bin/bulkhead-collector enforce off socket_connect

[Install]
WantedBy=multi-user.target
