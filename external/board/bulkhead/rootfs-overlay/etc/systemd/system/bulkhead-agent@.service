# SPDX-License-Identifier: AGPL-3.0-only
# bulkhead agent jail (template). One instance == one agent == one cgroup.
#
# THE RACE, AND HOW IT IS CLOSED (no sleep, no poll, fail-closed):
#   The per-agent egress manifest must be in the BPF map BEFORE the agent payload can
#   call connect(). The payload cannot set it itself (DynamicUser + empty caps + a
#   bpf()-EPERM seccomp filter make that physically impossible). So a `+`-prefixed
#   ExecStartPre runs the trusted collector with FULL privileges (the `+` restores
#   CAP_BPF for that one command, bypassing this unit's empty CapabilityBoundingSet),
#   in THIS instance's own cgroup (so `egress set self` resolves to exactly the cgroup
#   id the payload will run under). systemd runs ExecStartPre to completion and only
#   forks ExecStart on exit 0 -> strict happens-before. If the write fails (collector
#   down, bad class) the unit fails and the payload never launches: the agent never
#   runs UNRESTRICTED, it simply does not run.
#
# Instances are started on demand (no [Install]); per-instance egress is set via a
# bulkhead-agent@<id>.service.d/ drop-in (BULKHEAD_AGENT_EGRESS). The manifest only
# BITES when E2 is armed (bulkhead-enforce-egress.service); default-observe per ADR-0004.
[Unit]
Description=bulkhead agent jail (%i)
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-collector.service bulkhead-firewall.service bulkhead-enforce.service
Requires=bulkhead-collector.service

[Service]
Type=exec
Slice=bulkhead-agent.slice

# Default-deny manifest unless a per-instance drop-in overrides it (most-restrictive:
# local IPC + loopback only, no outbound network).
Environment=BULKHEAD_AGENT_EGRESS=loopback,other

# --- RECYCLE FIX (ADR-0012 composed-review F3): clear any one-shot grant INHERITED from a
#     predecessor that died at this cgroup inode before its ExecStopPost could clear it (a
#     crash skips ExecStopPost; the GC keeps a grant whose inode is live-again). Clearing at
#     STARTUP, before the payload forks, guarantees a fresh agent never inherits a stranded
#     E1/E3 grant. `+` for CAP_BPF; leading `-` so a missing entry never blocks the start. ---
ExecStartPre=-+/usr/bin/bulkhead-collector ctl grant-clear-self
# --- RACE FIX (ADR-0005), now E0-SAFE (ADR-0016): the manifest must be in egress_policy before
#     the payload can connect(). systemd still runs this +ExecStartPre to exit-0 completion before
#     forking ExecStart (happens-before unchanged, fail-closed unchanged). The ONLY change: the
#     bpf() Update is no longer done in THIS (non-TCB) cgroup — under E0 that would EPERM — it asks
#     the collector over the control socket, and the COLLECTOR (TCB, E0-exempt) writes the manifest
#     for the kernel-attested SELF cgid (the same cgroup the payload runs under). ---
ExecStartPre=+/usr/bin/bulkhead-collector ctl egress-set-self ${BULKHEAD_AGENT_EGRESS}

# --- the caged payload (MVP stub probe; the real agent runtime replaces it later) ---
ExecStart=/usr/bin/bulkhead-agent-run %i

# --- cgroup-inode-reuse hygiene: drop this cgroup's manifest AND any unconsumed one-shot
#     grants (ADR-0011) on exit, so a recycled cgroup can inherit neither. (+ for caps,
#     leading - so a missing entry / down collector never fails the stop). ---
ExecStopPost=-+/usr/bin/bulkhead-collector ctl egress-clear-self
ExecStopPost=-+/usr/bin/bulkhead-collector ctl grant-clear-self
# --- ADR-0015: a broker-minted DELEGATED child carries a transient /run drop-in and (if the
#     parent supplied a task) a /run/bulkhead/tasks/<inst>.task credential source the broker
#     wrote. Reap both on stop so a long-lived deployment's /run + daemon-reload cost don't grow
#     unboundedly. No-op for a non-delegated agent (its drop-in lives under /etc, not /run). `+`
#     for privilege (the jail can't write /run/systemd/system); leading `-` so absence never fails
#     the stop. A crash that skips ExecStopPost is backstopped by the collector GC (ADR Seam). ---
ExecStopPost=-+/bin/rm -rf /run/systemd/system/bulkhead-agent@%i.service.d
ExecStopPost=-+/bin/rm -f /run/bulkhead/tasks/%i.task

# --- fail-closed hardening floor (the bulkhead-selftest/llama-server profile). ---
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @obsolete @cpu-emulation @mount @reboot @swap @raw-io @module
SystemCallErrorNumber=EPERM
# AF_UNIX kept so the `other` class (local IPC) is exercisable; AF_INET/6 for egress
# that the BPF E2 manifest then gates per destination class.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
