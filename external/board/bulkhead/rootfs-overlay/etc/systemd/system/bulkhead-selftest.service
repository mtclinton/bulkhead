# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=bulkhead fail-closed boot self-test
Documentation=https://github.com/mtclinton/bulkhead
# Run AFTER the egress floor is loaded (so the forbidden-egress probe is subject
# to it) and BEFORE any service or agent. A non-zero exit fails this unit, and
# the Requires= on the gated units propagates that failure, blocking them.
After=bulkhead-firewall.service
Requires=bulkhead-firewall.service
Before=llama-server.service bulkhead-router.service bulkhead-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bulkhead-collector selftest
# Run under the same confinement an agent gets, so the probes test the real floor.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The collector binary links cilium/ebpf, which feature-probes via bpf() at startup
# even on the `selftest` path (which itself only does net+file probes). bpf() is not
# in @system-service, so under Yocto's seccomp-enabled systemd it was SIGSYS-killed
# (status=31/SYS) — Buildroot's systemd was -SECCOMP, so the filter was a no-op there.
# Return EPERM for unlisted syscalls instead of killing; the empty CapabilityBoundingSet
# still denies any real BPF use, and this is robust to per-Go-version syscall drift.
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
