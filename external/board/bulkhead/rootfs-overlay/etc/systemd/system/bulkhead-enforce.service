# SPDX-License-Identifier: AGPL-3.0-only
# BPF-LSM enforce arming for the bpf() hook (E0). ADR-0018: AUTO-ENABLED — the shipped image is
# ENFORCED BY DEFAULT (boots E0-armed) now that the full stack is armable end-to-end with
# delegation (ADR-0016). Arms AFTER the fail-closed self-test + the collector (pins the maps) +
# the broker is TCB-registered (the wait-broker-tcb gate below). Soft-disarm at runtime with
#   systemctl stop bulkhead-enforce   (routes enforce-off through the collector, so it works under
# armed E0). A failed arm leaves enforce_flags empty => the box degrades to safe observe (never a
# brick); enforce_flags-empty => observe by construction (ADR-0004).
# Disarm (soft, no reboot) with `systemctl stop bulkhead-enforce` (clears the toggle)
# or `bulkhead-collector enforce off bpf`. ADR-0016: that disarm now ROUTES through the
# collector control socket so the enforce_flags write is done from the collector's TCB
# context — without that, a disarm from this unit's own non-TCB cgroup would be EPERM'd
# the instant E0 is armed (the soft kill-switch would silently fail). Fail-open: if the
# collector isn't up, this unit just fails and the system stays in observe mode.
#
# ADR-0016: E0 (lsm/bpf deny) is now armable WITH delegation working. This unit pulls in + orders
# after the broker and BLOCKS (ExecStartPre) until the collector confirms the broker cgroup is in
# tcb_cgroups — so E0 never arms ahead of broker-TCB establishment (which would EPERM the broker's
# map ops). Once armed, the broker's gated writes flow from its genuine TCB context and agents'
# manifest writes flow through the collector control socket, so a jailed agent's DIRECT bpf() is
# the only thing E0 denies.
[Unit]
Description=bulkhead BPF-LSM enforce arming (opt-in: bpf hook)
Documentation=https://github.com/mtclinton/bulkhead
After=bulkhead-collector.service bulkhead-broker.service
Requires=bulkhead-collector.service
Wants=bulkhead-broker.service
# ADR-0016 review fix: a collector restart RemoveAll-re-pins a FRESH enforce_flags (= observe), so
# without this an E0-armed posture would silently drop to observe while this oneshot/RemainAfterExit
# unit still reported "active" (armed). PartOf= makes a collector restart also restart this unit, so
# it re-runs ExecStartPre=ctl wait-broker-tcb + ExecStart=enforce on bpf against the fresh map.
PartOf=bulkhead-collector.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Gate: do not arm E0 until the broker is established as TCB (else the broker's bpf() EPERMs).
ExecStartPre=/usr/bin/bulkhead-collector ctl wait-broker-tcb
ExecStart=/usr/bin/bulkhead-collector enforce on bpf
ExecStop=/usr/bin/bulkhead-collector enforce off bpf

[Install]
WantedBy=multi-user.target
