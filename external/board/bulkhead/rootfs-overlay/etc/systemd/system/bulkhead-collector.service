# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=bulkhead eBPF provenance collector
Documentation=https://github.com/mtclinton/bulkhead
# Gated on the fail-closed self-test: if it fails, the collector does not start.
After=bulkhead-selftest.service
Requires=bulkhead-selftest.service

[Service]
Type=exec
ExecStart=/usr/bin/bulkhead-collector run
Restart=on-failure
RestartSec=2
# Loading BPF and attaching the LSM program needs these caps; agents never get
# them — only this trusted collector does.
User=root
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The append-only audit log lives under the writable StateDirectory; the rest of
# the filesystem stays protected.
StateDirectory=bulkhead
# ADR-0016: the collector hosts the control socket (/run/bulkhead/control.sock) — the bpf()-write
# chokepoint through which non-TCB callers (the agent +ExecStartPre manifest write, the broker's
# TCB self-register) have the COLLECTOR do their map writes, so E0 (lsm/bpf deny) can stay armed.
# /run/bulkhead is created early by bulkhead-broker.socket's RuntimeDirectory; this hole lets the
# collector create the socket there under ProtectSystem=strict.
ReadWritePaths=/run/bulkhead
Environment=BULKHEAD_AUDIT_DIR=/var/lib/bulkhead/audit
# BPF JIT needs W+X, so MemoryDenyWriteExecute must stay off here.
MemoryDenyWriteExecute=no

# Syscall hardening for the TCB (ADR-0033/ADR-0041). The collector is the most privileged process in
# the system (it owns the eBPF path, the broker, and the audit-signing seed), so it gets a DEFAULT-DENY
# allowlist like every agent jail — not the permissive group-denylist it used to carry. The base is the
# standard @system-service set (which covers the Go runtime, file I/O, the AF_UNIX/AF_NETLINK sockets,
# epoll/mmap for the ringbuf, getsockopt for SO_PEERPIDFD, and the /proc reads behind the pidfd cgroup
# attestation), plus exactly two privileged extras the @system-service set excludes:
#   bpf             — every eBPF op: BPF_PROG_LOAD + BPF_MAP_* + BPF_LINK_CREATE (the 5 LSM attaches),
#                     and the control-socket map writes (gated by CAP_BPF).
#   perf_event_open — defensive: the cilium/ebpf loader feature-probes with it on some kernels (gated by
#                     CAP_PERFMON). The LSM links themselves are BPF_LINK_CREATE, not perf events.
# This is strictly TIGHTER than the old denylist and preserves its load-bearing property for free: io_uring
# is NOT in @system-service, so an io_uring ring — a syscall-INVISIBLE I/O channel the provenance collector
# must never open — is denied by the allowlist (as are @swap/@reboot/@module/@raw-io/@mount/@clock-setters,
# none of which are in @system-service). A missing syscall would fail-close the E0/E2 floor, so the set is
# VERIFIED by booting the real collector under it and passing the full live suite (verify-floor for
# load/attach/all-4-enforce-hooks/ringbuf/control-socket, verify-agent-orch for the broker/SO_PEERPIDFD
# delegation, verify-attest for signing + the TPM-quoted chain HEADs). EPERM (not KILL) keeps a denied
# call a handled error, not a crash.
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
