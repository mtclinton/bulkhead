#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# bulkhead-agent-run <instance> — MVP stub payload for a bulkhead agent jail.
#
# Runs INSIDE the per-agent cgroup + namespace + seccomp jail (bulkhead-agent@.service),
# subject to the BPF-LSM per-agent egress manifest that the unit's +ExecStartPre set on
# this cgroup. For v1 it just probes egress so per-agent E2 enforcement is observable
# end to end; the real agent runtime replaces this later. It probes two destination
# classes and logs each curl exit code:
#   public  : https://api.anthropic.com/  (host floor allows it via the dnsmasq nftset,
#             so a failure here is the BPF E2 manifest, not the nftables floor)
#   loopback: http://127.0.0.1:5353/      (dnsmasq's TCP listener; never floor-dropped)
# curl exit 7 == connect() returned EPERM == E2 denied this cgroup that destination class.
id="${1:-?}"
pub="${BULKHEAD_AGENT_PROBE:-https://api.anthropic.com/}"

# Delegation (ADR-0006): if BULKHEAD_AGENT_DELEGATE is set this agent acts as a PARENT
# and asks the broker to spawn a child whose egress = parent ∩ requested. The connect to
# the broker originates from THIS parent's cgroup, so the broker attests the parent
# ceiling from the kernel — the request body carries no identity to forge. The OK line
# (printed here) names the broker-minted child instance, which the child then probes.
if [ -n "${BULKHEAD_AGENT_DELEGATE:-}" ]; then
	echo "bulkhead-agent[$id]: delegating -> ${BULKHEAD_AGENT_DELEGATE}"
	bulkhead-collector delegate ${BULKHEAD_AGENT_DELEGATE}
	echo "bulkhead-agent[$id]: delegate rc=$?"
	exit 0
fi

# Egress expansion (ADR-0009): if BULKHEAD_AGENT_EXPAND is set this agent asks the broker
# (which blocks for operator approval) to WIDEN its OWN manifest. Probe public BEFORE
# (expect E2 deny=7), request the expansion (the `expand` call blocks across the gate, all
# in THIS process/cgroup), then probe public AFTER — on approval the same cgroup's public
# class flips denied->allowed. Both rcs logged for the harness.
if [ -n "${BULKHEAD_AGENT_EXPAND:-}" ]; then
	curl -s -o /dev/null --noproxy '*' --max-time 8 "$pub"; before=$?
	echo "bulkhead-agent[$id]: pre-expand public rc=${before}"
	echo "bulkhead-agent[$id]: requesting expand -> ${BULKHEAD_AGENT_EXPAND}"
	bulkhead-collector expand ${BULKHEAD_AGENT_EXPAND}; erc=$?
	echo "bulkhead-agent[$id]: expand rc=${erc}"
	curl -s -o /dev/null --noproxy '*' --max-time 8 "$pub"; after=$?
	echo "bulkhead-agent[$id]: post-expand public rc=${after}"
	exit 0
fi

# Narrow demo (ADR-0010): if BULKHEAD_AGENT_NARROW_PROBE is set this agent just STAYS ALIVE
# (its manifest is set by +ExecStartPre) so an operator can `narrow` it MID-FLIGHT. The
# clamp's effect is verified from the LIVE egress_policy map (`bulkhead-collector status`)
# plus the agent staying active — i.e. throttled IN PLACE, not killed. No self-probe loop: a
# long-running shell would block-buffer its stdout (nothing reaches the journal until exit),
# and the map state is the authoritative proof of the manifest change anyway.
if [ -n "${BULKHEAD_AGENT_NARROW_PROBE:-}" ]; then
	exec sleep 600
fi

curl -s -o /dev/null --noproxy '*' --max-time 8 "$pub"
rcp=$?
curl -s -o /dev/null --noproxy '*' --max-time 4 http://127.0.0.1:5353/
rcl=$?

echo "bulkhead-agent[$id]: public(${pub}) rc=${rcp} ; loopback(127.0.0.1:5353) rc=${rcl}"
exit 0
