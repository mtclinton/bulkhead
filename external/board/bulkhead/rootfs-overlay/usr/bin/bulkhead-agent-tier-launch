#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# ADR-0031: resolve a workload CLASS to an isolation TIER and launch the agent in it (PRODUCTION-READINESS
# [81]). Tiers, weakest -> strongest: confined < runsc < firecracker. The selection is FAIL-CLOSED — an
# unknown/unvetted class can never land in the weakest shared-kernel tier:
#   - an unmapped (or invalidly-mapped) class gets the policy `default`;
#   - `default` is sanitized to never be weaker than `runsc` (even if the policy says default=confined);
#   - `firecracker` degrades to `runsc` when /dev/kvm is absent (strongest AVAILABLE, never below runsc);
#   - an EXPLICIT class->confined mapping IS honored (operator opt-in for a vetted, low-risk class).
# Usage:
#   bulkhead-agent-tier-launch --resolve <class>   # print the resolved tier; no side effects (for tests/ops)
#   bulkhead-agent-tier-launch <inst> [class]      # resolve + `systemctl start bulkhead-agent-<tier>@<inst>`
# Env: BULKHEAD_TIER_POLICY (policy path; default /etc/bulkhead/tier-policy.conf),
#      BULKHEAD_TIER_KVM (1|0 to override KVM availability; default = [ -e /dev/kvm ]),
#      BULKHEAD_TIER_DRYRUN (1 => print "WOULD-START <unit>" instead of starting it),
#      BULKHEAD_AGENT_CLASS (class used when not passed positionally).
set -eu
POLICY="${BULKHEAD_TIER_POLICY:-/etc/bulkhead/tier-policy.conf}"

valid_tier() { case "${1:-}" in confined|runsc|firecracker) return 0 ;; *) return 1 ;; esac; }
kvm_ok()     { case "${BULKHEAD_TIER_KVM:-}" in 1) return 0 ;; 0) return 1 ;; *) [ -e /dev/kvm ] ;; esac; }

# policy_get <key>: print the value of the last `key = value` line (comments + whitespace stripped). Always
# returns 0 (an absent key/file prints nothing), so `set -e` callers can use it in a command substitution.
policy_get() {
	[ -f "$POLICY" ] || return 0
	val=""
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%%#*}"
		case "$line" in *=*) ;; *) continue ;; esac
		key="${line%%=*}"; v="${line#*=}"
		key="$(printf '%s' "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		v="$(printf '%s' "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		[ "$key" = "$1" ] && val="$v"
	done < "$POLICY"
	[ -n "$val" ] && printf '%s\n' "$val"
	return 0
}

# default_tier: the sanitized default — never weaker than runsc (the fail-closed floor for unknown classes).
default_tier() {
	d="$(policy_get default)"
	if valid_tier "$d" && [ "$d" != confined ]; then printf '%s\n' "$d"; else printf 'runsc\n'; fi
}

# resolve <class> -> the effective tier.
resolve() {
	t="$(policy_get "$1")"
	valid_tier "$t" || t="$(default_tier)"               # unmapped/invalid class -> sanitized default (>= runsc)
	if [ "$t" = firecracker ] && ! kvm_ok; then t=runsc; fi  # no KVM -> strongest AVAILABLE, never below runsc
	printf '%s\n' "$t"
}

case "${1:-}" in
	--resolve) [ $# -ge 2 ] || { echo "usage: $0 --resolve <class>" >&2; exit 2; }; resolve "$2"; exit 0 ;;
	""|-h|--help) echo "usage: $0 --resolve <class> | $0 <inst> [class]" >&2; exit 2 ;;
esac

inst="$1"
case "$inst" in ""|*[!A-Za-z0-9_-]*) echo "$0: invalid instance id: $inst" >&2; exit 2 ;; esac
class="${2:-${BULKHEAD_AGENT_CLASS:-default}}"
tier="$(resolve "$class")"
unit="bulkhead-agent-${tier}@${inst}.service"
echo "bulkhead-agent-tier-launch: class=${class} -> tier=${tier} -> ${unit}" >&2
if [ "${BULKHEAD_TIER_DRYRUN:-0}" = 1 ]; then
	printf 'WOULD-START %s\n' "$unit"
	exit 0
fi
exec systemctl start "$unit"
