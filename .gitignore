# SPDX-License-Identifier: AGPL-3.0-only

# Buildroot (fetched, never vendored) + build artifacts
/buildroot/
/output/
/dl/
*.config.old

# Yocto / OpenEmbedded (production phase)
/build/
/downloads/
/sstate-cache/
/tmp/
bitbake.lock
# Fetched Yocto layers + build output (meta-bulkhead/ is committed; these are not)
/yocto/poky/
/yocto/meta-openembedded/
/yocto/meta-rauc/
/yocto/meta-rauc-community/
/yocto/meta-security/
/yocto/build/

# Python (qemu verification harness byte-compile cache)
__pycache__/
*.pyc

# Go
/bin/
*.test
*.out
# Compiled package binaries (output of `go build .` / `go build ./...` in a module dir)
/src/collector/collector
/src/router/router
/src/agent/agent
/src/proxy/proxy
vendor/
# ...except the collector's vendored deps: committed so the air-gapped Buildroot
# build works (SITE_METHOD=local sources are never auto-vendored).
!src/collector/vendor/
!src/collector/vendor/**

# Model weights — fetched at build time, never committed
*.gguf

# Secrets — never commit (defense in depth behind the gitleaks gate)
.env
*.pem
*.key
*.crt
*.cred
*.tpm
*.secret
*authkey*
