#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# First-boot provisioning of the audit-log signing seed (ADR-0008). Generates 32 random
# bytes ONCE and persists them on /data so the collector + broker have a STABLE signing
# identity across reboots — replacing the ephemeral per-boot key that left the signed
# audit chain resting on an unattested boot. Idempotent + self-healing. If it cannot
# provision a 32-byte seed, the collector's BULKHEAD_REQUIRE_SEALED_KEY guard fails closed
# (never signs with an ephemeral key).
#
# KEY MODE (BULKHEAD_SEAL_KEY):
#   plain  (default, the VM/dev phase) — write the seed PLAINTEXT to /data/bulkhead/audit-seed
#          (0600 root); the collector loads it via LoadCredential. Generated on-device (never
#          shipped in the image) and protected by fs perms + the read-only rootfs + the
#          nftables/BPF-LSM isolation floor. qemu's vTPM unseal is unreliable (ADR-0001 #12 /
#          systemd #21747), so this is the reliable VM mechanism.
#   tpm2   (bare metal) — hardware-seal the seed to /data/bulkhead/audit-seed.cred via
#          systemd-creds (PCR 7, stable across RAUC A/B); the collector loads it via
#          LoadCredentialEncrypted. Encrypted at rest, unsealable only on the expected boot.
#          On real hardware set BULKHEAD_SEAL_KEY=tpm2 AND switch the collector/broker
#          drop-ins to LoadCredentialEncrypted=audit-seed:/data/bulkhead/audit-seed.cred.
#
# NB: busybox `head` has no -c; use dd for the random seed.
set -eu
DATADIR="/data/bulkhead"
SEED="$DATADIR/audit-seed"
CRED="$DATADIR/audit-seed.cred"
KEY="${BULKHEAD_SEAL_KEY:-plain}"
mkdir -p "$DATADIR"

# ADR-0030: refuse to mint a FRESH seed over surviving chains. If the seed/cred is absent or
# unreadable but signed audit chains from a prior boot still exist on /data, minting a new seed
# would derive a new pubkey under which every surviving record fails ed25519.Verify -> the
# verify-audit boot gate bricks with a cryptic per-chain "signature invalid". That is correct
# fail-closed for TAMPER, but for a legitimate seed loss (a backup/restore that excluded the
# seed, a TPM clear / PCR-7 change) it should be a LOUD, self-documenting stop that leaves state
# untouched for recovery — not a fresh seed that masks the cause. So: detect surviving chains and
# refuse to mint, naming the situation. The operator restores the seed from backup and reboots
# (this script then finds it valid and leaves it -> the box boots), OR, having genuinely lost the
# seed and accepting the loss of prior audit history, sets BULKHEAD_SEAL_FORCE_NEW=1 to authorize
# a fresh identity. First boot / a fully-wiped /data has no chains, so this never blocks it.
CHAINS="$DATADIR/audit/provenance.jsonl $DATADIR/audit-broker/provenance.jsonl $DATADIR/audit/control.jsonl $DATADIR/audit-router/provenance.jsonl $DATADIR/audit-egress/provenance.jsonl"
refuse_if_chains_present() {
	[ "${BULKHEAD_SEAL_FORCE_NEW:-0}" = 1 ] && return 0
	for c in $CHAINS; do
		# The live chain file AND any sealed rotation segments (<chain>.NNNNNN, ADR-0040) count as surviving
		# signed history: a box that rotated and then lost its seed has its signed records in the SEGMENTS,
		# with the live file possibly small or empty. Checking only the live file would let such a box mint a
		# fresh seed and brick on the surviving segments. (An unmatched .[0-9]* glob stays literal, so the
		# `-s` test simply skips it.)
		for f in "$c" "$c".[0-9]*; do
			[ -s "$f" ] || continue
			echo "bulkhead-seal: SEALED AUDIT KEY LOST — the signing seed is absent/unreadable but a signed audit" >&2
			echo "bulkhead-seal: chain survives on /data ($f). Minting a fresh seed would BRICK the boot (every prior" >&2
			echo "bulkhead-seal: record fails signature). REFUSING to mint over surviving chains; state left untouched." >&2
			echo "bulkhead-seal: Restore the seed from backup and reboot, or set BULKHEAD_SEAL_FORCE_NEW=1 to mint a new" >&2
			echo "bulkhead-seal: identity (this DISCARDS the ability to verify all prior audit history)." >&2
			exit 1
		done
	done
}

if [ "$KEY" = tpm2 ]; then
	# bare metal: a cred is good iff it decrypts to >= an Ed25519 seed (32 bytes).
	cred_ok() {
		[ -e "$1" ] || return 1
		n=$(systemd-creds decrypt --name=audit-seed "$1" - 2>/dev/null | wc -c)
		[ "${n:-0}" -ge 32 ]
	}
	if cred_ok "$CRED"; then echo "bulkhead-seal: $CRED valid (tpm2); leaving it"; exit 0; fi
	refuse_if_chains_present # don't mint a new key under which the surviving chains would fail to verify
	echo "bulkhead-seal: tpm2-sealing audit seed (PCR ${BULKHEAD_SEAL_PCRS:-7})"
	rm -f "$CRED" "$CRED.tmp"
	if dd if=/dev/urandom bs=32 count=1 2>/dev/null \
	     | systemd-creds encrypt --name=audit-seed --with-key=tpm2 --tpm2-pcrs="${BULKHEAD_SEAL_PCRS:-7}" - "$CRED.tmp" 2>&1; then
		mv "$CRED.tmp" "$CRED"; chmod 0600 "$CRED"
		cred_ok "$CRED" || { echo "bulkhead-seal: ERROR sealed cred does not verify" >&2; rm -f "$CRED"; exit 1; }
		echo "bulkhead-seal: tpm2-sealed + verified at $CRED"
		exit 0
	fi
	rm -f "$CRED.tmp"; echo "bulkhead-seal: ERROR tpm2-sealing audit seed" >&2; exit 1
fi

# plain (VM/dev): a 32-byte plaintext seed, provisioned once and kept thereafter.
if [ -e "$SEED" ] && [ "$(wc -c < "$SEED" 2>/dev/null || echo 0)" -eq 32 ]; then
	echo "bulkhead-seal: $SEED present (32B); leaving it"
	exit 0
fi
refuse_if_chains_present # don't mint a new key under which the surviving chains would fail to verify
echo "bulkhead-seal: provisioning plaintext audit seed at $SEED"
rm -f "$SEED.tmp"
dd if=/dev/urandom bs=32 count=1 2>/dev/null > "$SEED.tmp"
if [ "$(wc -c < "$SEED.tmp" 2>/dev/null || echo 0)" -eq 32 ]; then
	mv "$SEED.tmp" "$SEED"; chmod 0600 "$SEED"
	echo "bulkhead-seal: wrote 32-byte audit seed at $SEED"
else
	rm -f "$SEED.tmp"; echo "bulkhead-seal: ERROR provisioning seed" >&2; exit 1
fi
