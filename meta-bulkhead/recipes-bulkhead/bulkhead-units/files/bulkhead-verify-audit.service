# SPDX-License-Identifier: AGPL-3.0-only
# F5: boot-time verification of the persisted, signed audit chains. The collector and broker
# Ed25519-sign every record over a SHA-256 hash chain (ADR-0008); this unit is the missing
# reader — it recomputes the canonical encoding, hash, prev-hash linkage and signature for
# every record persisted on /data from prior boots, BEFORE the collector/broker append new
# records. A tampered or forged chain fails this unit; the selftest gate Requires= it (via a
# Yocto drop-in), so a broken chain refuses the boot.
#
# Verifies against the SEALED seed (LoadCredential audit-seed -> sealedAuditPub), NOT the
# exported audit-pub.txt: an attacker who rewrites a chain can also rewrite a sibling pubkey
# file, but cannot forge a signature under the sealed/persistent seed. Runs as root holding
# ONLY CAP_DAC_READ_SEARCH — a read-only DAC bypass. The collector/broker run User=root so
# their chains are 0600 root:root (root reads them as owner), but the ROUTER runs
# DynamicUser=yes (ADR-0027), so its chain is 0600 owned by a per-boot NON-root uid that
# capability-less root cannot open — a live boot caught this as "open
# .../audit-router/provenance.jsonl: permission denied", which failed the gate CLOSED and
# bricked the boot. CAP_DAC_READ_SEARCH lets the gate READ any chain regardless of owner; it
# still writes nothing and cannot modify a chain (that is CAP_DAC_OVERRIDE, deliberately NOT
# granted), so the "read-only verifier" property holds.
#
# Yocto-only (needs /data + the sealed seed). ConditionPathIsMountPoint=/data mirrors the
# seal service (F6): no real /data => nothing trustworthy to verify, skip and let the
# collector fail closed on the missing sealed key rather than hard-failing the boot here.
[Unit]
Description=bulkhead audit-chain verification (boot gate)
Documentation=https://github.com/mtclinton/bulkhead
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data
After=bulkhead-seal-audit-key.service
Requires=bulkhead-seal-audit-key.service
Before=bulkhead-collector.service bulkhead-broker.service bulkhead-router.service bulkhead-egress-proxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Same sealed seed the signer uses -> verify-audit derives the public key from it.
LoadCredential=audit-seed:/data/bulkhead/audit-seed
ExecStart=/usr/bin/bulkhead-collector verify-audit /data/bulkhead/audit/provenance.jsonl
ExecStart=/usr/bin/bulkhead-collector verify-audit /data/bulkhead/audit-broker/provenance.jsonl
# ADR-0017: the collector's CONTROL chain — the signed log of control-socket authority writes
# (per-agent egress manifests, broker TCB registration, enforce toggles). Sibling of the
# collector chain in the same audit dir; a missing file (no control writes yet) verifies as OK.
ExecStart=/usr/bin/bulkhead-collector verify-audit /data/bulkhead/audit/control.jsonl
# ADR-0027: the ROUTER's signed routing-decision chain, persisted on /data and signed with the same
# sealed seed (domain="router", resolved from the audit-router/ path). A missing file (no routing yet,
# e.g. first boot) verifies as OK; a present-but-tampered router chain fails the boot like the others.
ExecStart=/usr/bin/bulkhead-collector verify-audit /data/bulkhead/audit-router/provenance.jsonl
# ADR-0034: the egress PROXY's signed egress-decision chain, persisted on /data and signed with the
# same sealed seed (domain="egress-proxy", resolved from the audit-egress/ path). A missing file (no
# confined-agent egress yet) verifies as OK; a present-but-tampered chain fails the boot like the others.
ExecStart=/usr/bin/bulkhead-collector verify-audit /data/bulkhead/audit-egress/provenance.jsonl
User=root
# Read-only DAC bypass: needed to read the router's DynamicUser-owned 0600 chain (see header).
# NOT CAP_DAC_OVERRIDE — the gate must never be able to modify a chain, only read it.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
# Independently enabled AND pulled in by the selftest gate's Requires= (the drop-in) —
# either path makes a broken chain block the boot; both is belt-and-suspenders.
WantedBy=multi-user.target
