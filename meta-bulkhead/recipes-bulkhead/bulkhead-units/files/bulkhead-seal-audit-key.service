# First-boot sealing of the audit-log signing seed to the device TPM (ADR-0008). Yocto-
# only (needs /data + a TPM); ordered before the collector, which LoadCredentialEncrypted
# unseals the result. Idempotent — seals once, later boots just unseal. If it fails (no
# TPM / sealing error) the collector's BULKHEAD_REQUIRE_SEALED_KEY guard fails it closed
# rather than signing with an ephemeral key.
[Unit]
Description=bulkhead first-boot TPM sealing of the audit signing seed
Documentation=https://github.com/mtclinton/bulkhead
DefaultDependencies=no
After=data.mount
RequiresMountsFor=/data
ConditionPathExists=/dev/tpmrm0
Before=bulkhead-collector.service bulkhead-broker.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bulkhead-seal-audit-key
# Sealing touches /data + the TPM; keep the rest of the surface minimal.
ProtectSystem=strict
ReadWritePaths=/data
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=sysinit.target
